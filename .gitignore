# --- Track: code, configs, docs, examples/tiny_sample, .gitkeep placeholders ---
# --- Do not commit: full raw/processed data, checkpoints, trackers, logs, bulky exports ---

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# Virtual environments
.venv/
venv/
env/

# Secrets / local env
.env
.env.*

# Local datasets (keep only .gitkeep under raw/processed, any depth)
data/raw/**
!data/raw/**/.gitkeep
data/processed/**
!data/processed/**/.gitkeep

# A-LLMRec / SASRec outputs
models/saved_models/
recommendation_output.txt

# Prepared flat files for A-LLMRec (optional to version)
!data/amazon/
!data/amazon/.gitkeep
!data/amazon/*.txt
!data/amazon/*_text_name_dict.json.gz

# Ship tiny fixtures with the repo
!examples/tiny_sample/**

# Avoid accidentally committing trained weights under examples/
examples/tiny_sample/**/*.pth
examples/tiny_sample/**/*.pt
examples/tiny_sample/**/*.ckpt
examples/tiny_sample/**/wandb/

# Bulk / compressed data (any path)
*.csv.gz
*.jsonl.gz
*.json.gz
*.tsv.gz
*.part
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.npz
*.npy
*.pkl
*.pickle

# Archives / local dumps
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Model weights (Python source remains tracked)
checkpoints/
checkpoint/
**/*.pt
**/*.pth
**/*.ckpt
**/*.bin
**/*.safetensors
**/*.onnx
*.gguf

# Experiment tracking & training runs
runs/
wandb/
mlruns/
tensorboard/
tensorboard_logs/
lightning_logs/
hydra/
.hydra/
outputs/
output/

# Logs
logs/
**/*.log
*.log

# Empty layout only: add .gitkeep under results/ if you want the tree
results/**
!results/**/
!results/**/.gitkeep

# Jupyter checkpoint sidecars
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Placeholder files
!.gitkeep

# A-LLMRec text dict uses .json.gz suffix but is pickle; un-ignore after generic *.json.gz
!data/amazon/*_text_name_dict.json.gz

# SASRec checkpoints used by A-LLMRec RecSys loader
!pre_train/sasrec/**/*.pth
