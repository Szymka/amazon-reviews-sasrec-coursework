# Python cache
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Local environment files
.env
.env.*

# Large raw and processed data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv.gz
*.jsonl.gz
*.json.gz
*.part

# Archives and ad-hoc local data exports
*.zip
*.tar
*.tar.gz
*.parquet

# Model checkpoints and training artifacts
checkpoints/
checkpoint/
*.pt
*.pth
*.ckpt
*.bin
runs/
wandb/
logs/
*.log

# Training outputs and results (keep only small summaries)
train/*.pth
train/*.pt
train/*.ckpt
train/*_config.json
train/*.log
evaluation/*.pth
evaluation/*.pt
evaluation/*.ckpt

# Jupyter notebooks checkpoints
.ipynb_checkpoints/
*.ipynb

# IDE and system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Keep tiny examples trackable
!examples/tiny_sample/**

# Keep directory placeholders
!.gitkeep
